# Plantilla de variables de entorno. Copiar a .env y completar.
# Este archivo se sube al repositorio: nunca pongas aquí valores reales.

# Reference ID del proyecto (Project Settings > General > Project ID).
SUPABASE_PROJECT_REF=

# --- Cliente (navegador) ---
# Las variables con prefijo VITE_ entran al bundle y son públicas.
# URL del proyecto: https://<SUPABASE_PROJECT_REF>.supabase.co
VITE_SUPABASE_URL=
# Clave pública "anon" (Project Settings > API Keys). Protegida por RLS.
VITE_SUPABASE_ANON_KEY=

# --- Solo scripts del servidor (scripts/cargar-seed.ts) ---
# Clave secreta "service_role": salta RLS. SIN prefijo VITE_ para que nunca
# llegue al navegador. No la compartas ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
