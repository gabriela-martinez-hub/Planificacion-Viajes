{
  "name": "eje-cafetero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PWA para planificar viajes por Caldas, Quindío y Risaralda",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,scripts,supabase/seed}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,scripts,supabase/seed}/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/cargar-seed.ts",
    "seed:dry-run": "tsx scripts/cargar-seed.ts --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.59.0",
    "leaflet": "1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "4.2.1",
    "react-leaflet-cluster": "2.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "1.9.12",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^1.6.0"
  }
}
