# Archivos temporales del tablero (orquestador-proyecto)
control/.tablero.lock
control/.tablero.*.tmp

# Progreso reanudable del generador de clima (T-25); se regenera solo
supabase/seed/.clima-progreso.json

# Dependencias
node_modules

# Build
dist
dist-ssr
dev-dist
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Entorno (nunca subir secretos)
.env
.env.*
!.env.example

# Caché de herramientas
.eslintcache
coverage
*.tsbuildinfo

# Python (caché que generan los scripts del tablero; se regenera sola)
